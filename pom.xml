<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>hcmute.vn</groupId>
  <artifactId>LoginMVC</artifactId>
  <version>1.0</version>
  <packaging>war</packaging>
  
  <dependencies>
    <!-- 1. Bộ Servlet & JSP (Chuẩn cho Tomcat 11) -->
    <dependency>
        <groupId>jakarta.servlet</groupId>
        <artifactId>jakarta.servlet-api</artifactId>
        <version>6.0.0</version>
        <scope>provided</scope>
    </dependency>
    <dependency>
        <groupId>jakarta.servlet.jsp.jstl</groupId>
        <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
        <version>3.0.0</version>
    </dependency>
    <dependency>
        <groupId>org.glassfish.web</groupId>
        <artifactId>jakarta.servlet.jsp.jstl</artifactId>
        <version>3.0.1</version>
    </dependency>
    
    <!-- 2. Driver kết nối SQL Server -->
    <dependency>
        <groupId>com.microsoft.sqlserver</groupId>
        <artifactId>mssql-jdbc</artifactId>
        <version>12.6.1.jre11</version>
    </dependency>
    
    <!-- 3. Bộ JPA / Hibernate (Hạ về 6.4.4 để đồng bộ hoàn hảo với hệ thống) -->
    <dependency>
        <groupId>org.hibernate.orm</groupId>
        <artifactId>hibernate-core</artifactId>
        <version>6.4.4.Final</version>
    </dependency>
    
    <!-- 4. Bộ Validation (Kiểm tra dữ liệu) -->
    <dependency>
        <groupId>org.hibernate.validator</groupId>
        <artifactId>hibernate-validator</artifactId>
        <version>8.0.5.Final</version>
    </dependency>
    <dependency>
        <groupId>jakarta.validation</groupId>
        <artifactId>jakarta.validation-api</artifactId>
        <version>3.1.1</version>
    </dependency>
    
    <!-- Thư viện giao tiếp Email -->
	<dependency>
    	<groupId>jakarta.mail</groupId>
    	<artifactId>jakarta.mail-api</artifactId>
    	<version>2.1.3</version>
	</dependency>
<!-- Trình thực thi Angus Mail -->
	<dependency>
    	<groupId>org.eclipse.angus</groupId>
    	<artifactId>angus-mail</artifactId>
    	<version>2.0.3</version>
	</dependency>
	
	<dependency>
    	<groupId>org.sitemesh</groupId>
    	<artifactId>sitemesh</artifactId>
   	 <version>3.2.1</version>
	</dependency>

  </dependencies>
  
  <build>
    <plugins>
      <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.11.0</version>
          <configuration>
              <source>25</source> <!-- Lưu ý: Đảm bảo máy bạn đã cài JDK 25, nếu không hãy hạ xuống 17 hoặc 21 -->
              <target>25</target>
          </configuration>
      </plugin>
    </plugins>
  </build>
</project>